# Copy this file to .env (never commit .env)

# Inside Docker the database host is "db". If you run the API outside Docker, use localhost.
DATABASE_URL=postgresql://postgres:postgres@db:5432/search_engine

# The Python search service (only reachable inside Docker as "search").
SEARCH_URL=http://search:8000

PORT=3000
WEB_URL=http://localhost:5173
PDF_DIR=/pdfs

# Used later to sign admin login tokens. Put a long random string in your .env.
JWT_SECRET=change-me
